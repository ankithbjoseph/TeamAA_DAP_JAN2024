# Sample environment file for TeamAA_DAP_JAN2024
# Copy this to .env and fill values before running docker-compose

# Postgres
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres
POSTGRES_DB_APP=projectdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB
MONGO_INITDB_ROOT_USERNAME=your_mongo_user
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password
MONGO_HOST=mongodb
MONGO_PORT=27017

# PgAdmin
PGADMIN_EMAIL=your-email@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# Optional: hostnames used by services (override if necessary)
# e.g. POSTGRES_HOST=postgres

# Note: do NOT commit actual secret values to version control. Use this file as a template.